# Files Vercel does not upload. vercel.json + api/index.php explain the deploy.

# The PHP runtime runs `composer install --no-dev` itself, on Linux
/vendor
/node_modules

# Secrets live in the Vercel project's Environment Variables (see .env.vercel.example)
.env
.env.*

# Written to /tmp at runtime instead (api/index.php); local copies may hold dev-only providers or logs
/storage
/bootstrap/cache/*.php

# No build step: the API serves no Vite assets (welcome.blade.php falls back to inline styles without a
# manifest). Without package.json Vercel neither detects Vite as the framework nor runs `npm run build`.
/package.json
/vite.config.js

# Local tooling
/tests
/test_api.php
/phpunit.xml
/.phpunit.result.cache
