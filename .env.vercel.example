# =============================================================================
# QueueMic backend on Vercel — production environment variables
#
# Fill in the blanks, then paste this file into Vercel > Project > Settings >
# Environment Variables (the form accepts a pasted .env file).
# A change only reaches new deployments, so redeploy after editing a variable.
#
# Differences from .env.example, and why:
#   - Supabase Postgres, not local MySQL. vercel.json pins the functions to sin1
#     (Singapore), next to the ap-southeast-1 pooler and Pusher's ap1 cluster.
#   - Pusher, not Reverb: Vercel cannot host a long-lived WebSocket server.
#   - Logs go to stderr (Vercel > Logs); local files would vanish with the instance.
#   - Database cache: shared by every function instance (rate limits, song search cache).
#   - Queue sync: no worker runs on Vercel (broadcasts already use ShouldBroadcastNow).
#
# Migrations do not run on Vercel. Before the first deploy, and after each new
# migration, run them from your machine with these DB_* values exported:
#   php artisan migrate --force
# =============================================================================

APP_NAME=QueueMic
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The deployment's public URL, e.g. https://queuemic-api.vercel.app
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase > Project Settings > Database > Connection pooler (session mode, port 5432)
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# dashboard.pusher.com > your Channels app > App Keys
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

KARAOKE_PROVIDER_DRIVER=youtube
YOUTUBE_API_KEY=
# KARAOKE_HOST_AWAY_MINUTES=30
# KARAOKE_UNUSED_SONG_DAYS=7

# App update prompts (config/app_version.php). Set after a build is live in the stores.
# APP_LATEST_VERSION=1.0.0
# APP_MIN_SUPPORTED_VERSION=1.0.0
