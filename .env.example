# =============================================================================
# QueueMic backend — copy to .env, then:
#   composer install
#   php artisan key:generate
#   php artisan migrate
#   php artisan serve --host=0.0.0.0 --port=8001
#   php artisan reverb:start          (only when BROADCAST_CONNECTION=reverb)
# =============================================================================

APP_NAME=QueueMic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# `php artisan serve` handles one request at a time by default; with workers a slow
# song search no longer blocks queue adds and playback heartbeats
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local MySQL (fastest for development: ~0.3 ms per query)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queuemic
DB_USERNAME=queuemic
DB_PASSWORD=

# Supabase Postgres (remote; ~130 ms per query from a laptop). Values from
# Supabase > Project Settings > Database > Connection pooler.
# DB_CONNECTION=pgsql
# DB_HOST=aws-1-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Realtime broadcasting — pick one: reverb | pusher
# -----------------------------------------------------------------------------
# reverb = self-hosted WebSocket server (php artisan reverb:start), good for local dev
# pusher = Pusher Channels (hosted), planned for production
# The mobile/web app asks the backend which one to use (GET /api/v1/broadcasting/config),
# so switching only needs this line changed.
BROADCAST_CONNECTION=reverb

# --- Reverb (used when BROADCAST_CONNECTION=reverb) ---
# Any random strings work; `php artisan reverb:install` can generate them.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the Reverb server listens on this machine. Laravel publishes events here directly.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8082
# Public address the apps connect to:
#   same Wi-Fi -> your laptop's LAN IP, port 8082, scheme http
#   tunnel     -> run `cloudflared tunnel --url http://localhost:8082`, then use the
#                 printed *.trycloudflare.com host, port 443, scheme https
#                 (the URL changes every time cloudflared restarts — update it here)
REVERB_HOST=localhost
REVERB_PORT=8082
REVERB_SCHEME=http

# --- Pusher (used when BROADCAST_CONNECTION=pusher) ---
# dashboard.pusher.com > your Channels app > App Keys. Cluster ap1 = Singapore.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file keeps cache reads off the database (cached song searches become near-instant)
CACHE_STORE=file
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Karaoke
# -----------------------------------------------------------------------------
KARAOKE_PROVIDER_DRIVER=youtube
# Optional official YouTube Data API key; without it the app reads public search results
YOUTUBE_API_KEY=
# A room with no song added and nothing playing for this many minutes is closed and deleted
KARAOKE_ROOM_IDLE_MINUTES=30
# Cached songs no queue uses and no search returned for this many days are deleted
KARAOKE_UNUSED_SONG_DAYS=7

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
